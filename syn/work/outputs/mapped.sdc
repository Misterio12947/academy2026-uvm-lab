# Created by write_sdc on Thu Jul 30 05:07:28 2026

###################################################################
set sdc_version 2.1

set_units -time ns -resistance kOhm -capacitance pF -voltage V -current mA
set_load -pin_load 0.04 [get_ports {dout_low[7]}]
set_load -pin_load 0.04 [get_ports {dout_low[6]}]
set_load -pin_load 0.04 [get_ports {dout_low[5]}]
set_load -pin_load 0.04 [get_ports {dout_low[4]}]
set_load -pin_load 0.04 [get_ports {dout_low[3]}]
set_load -pin_load 0.04 [get_ports {dout_low[2]}]
set_load -pin_load 0.04 [get_ports {dout_low[1]}]
set_load -pin_load 0.04 [get_ports {dout_low[0]}]
set_load -pin_load 0.04 [get_ports {dout_high[7]}]
set_load -pin_load 0.04 [get_ports {dout_high[6]}]
set_load -pin_load 0.04 [get_ports {dout_high[5]}]
set_load -pin_load 0.04 [get_ports {dout_high[4]}]
