#===============================================================================
# .gitignore para flujo VCS + Verdi + URG (Synopsys)
#===============================================================================

# ---- VCS: artefactos de compilacion y simulacion ----
**/csrc/
**/simv
**/simv.daidir/
**/simv.vdb/
**/simv.kdb
**/ucli.key
**/vc_hdrs.h
**/vc_hdrs.c
**/tr_db.log
**/AN.DB/

# ---- VCS: logs ----
**/*.log
**/compile.log
**/sim_*.log
**/cm.log
**/novas_dump.log

# ---- Verdi ----
**/verdiLog/
**/verdi_config_file
**/verdi.cmd
**/verdi.cmd.bak
**/verdi.log
**/novas.*
**/vdCovLog/
**/DVEfiles/

# ---- Waveforms ----
**/*.fsdb
**/*.vpd
**/*.vcd
**/*.wlf
**/*.shm/

# ---- URG: reportes generados ----
**/cov_report/
**/cov_report_raw/
**/urgReport/
**/*.vdb.bk

# ---- Sistema ----
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ---- Editores ----
.vscode/
.idea/
*.sublime-*

# ---- Python (si scripts/ los usa) ----
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# ---- VCS: dotfiles ocultos de compilacion FSM/coverage ----
**/.fsm.*
**/.cov.*
**/.vcs.*
**/.*.verilog.xml

# ---- Synthesis work (DC genera mucho ruido) ----
syn/work/dc_work/
syn/work/command.log
syn/work/*.svf
syn/work/filenames.log
syn/work/*.pvl
syn/work/*.syn
syn/work/*.mr
# Conservar reportes y netlist finales, ignorar intermedios:
# (si quieres versionar reportes, no los ignores)
# ===== Formality LEC (ruido de trabajo) =====
lec/FM_INFO/
lec/formality_svf/
lec/*.fm.cdf
lec/*.log
lec/DEFAULT/
lec/fmv_tb/
# Conservar solo scripts y resultados:
#   lec/scripts/  y  lec/run.sh  SI se versionan
#   lec/*.rpt (reportes de equivalencia) SI se versionan

# ===== Design Compiler work (ruido) =====
syn/work/alib-52/
syn/work/dc_work/
syn/work/command.log
syn/work/*.svf
syn/work/filenames.log
syn/work/*.pvl
syn/work/*.syn
syn/work/*.mr

# ===== Libs (los .db son binarios pesados del PDK) =====
libs/
